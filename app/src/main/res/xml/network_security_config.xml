<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext globally — Ollama servers run HTTP by default on user-controlled
         local networks, so a global HTTPS-only policy is too restrictive here. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
